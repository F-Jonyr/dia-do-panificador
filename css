*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{

background:#111;

color:white;

overflow-x:hidden;

}

canvas{

position:fixed;

width:100%;

height:100%;

z-index:-1;

}

header{

height:100vh;

display:flex;

justify-content:center;

align-items:center;

text-align:center;

background:linear-gradient(rgba(0,0,0,.7),rgba(0,0,0,.8));

}

.overlay{

max-width:900px;

padding:40px;

backdrop-filter:blur(10px);

border:1px solid rgba(255,255,255,.2);

border-radius:20px;

}

h1{

font-size:70px;

color:#ffcc66;

}

h2{

margin:20px;

font-size:40px;

}

p{

line-height:1.9;

font-size:18px;

}

.btn{

display:inline-block;

margin-top:30px;

padding:15px 35px;

background:#d89b28;

color:white;

text-decoration:none;

border-radius:40px;

transition:.4s;

}

.btn:hover{

transform:scale(1.1);

background:#ffb700;

}

section{

padding:90px 10%;

}

.cards{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:30px;

}

.card{

padding:30px;

background:rgba(255,255,255,.08);

border-radius:20px;

backdrop-filter:blur(10px);

transition:.4s;

}

.card:hover{

transform:translateY(-10px);

box-shadow:0 0 30px #ffb700;

}

.numbers{

display:flex;

justify-content:space-around;

flex-wrap:wrap;

text-align:center;

background:#1c1c1c;

}

.counter{

font-size:70px;

color:#ffcc66;

}

footer{

padding:40px;

text-align:center;

background:black;

color:#aaa;

}

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-thumb{

background:#ffb700;

}
